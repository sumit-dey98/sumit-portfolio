# ---------------------------------------------------------------------------
# Cloudinary (OPTIONAL)
# ---------------------------------------------------------------------------
# Only needed if you want to host media on Cloudinary and use
# `node cloudinaryUrlsGenerator.js` to regenerate src/data/cloudinary-urls.js.
# The site runs fine without this - just point your project media at files
# in /public instead (see src/data/data.js).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Destination folder inside your Cloudinary account.
CLOUDINARY_FOLDER=portfolio/assets/

# ---------------------------------------------------------------------------
# Debug mode
# ---------------------------------------------------------------------------
# Vite exposes VITE_* to the app via import.meta.env.
# Set to 1 to enable; also toggleable at runtime from the console via
# __debug.on() / __debug.off() / __debug.toggle().
VITE_DEBUG=0
